# Токен бота из Discord Developer Portal -> Bot -> Reset Token
DISCORD_TOKEN=

# ID сервера для мгновенной синхронизации слеш-команд (рекомендуется)
# Если оставить пустым, команды синхронизируются глобально и могут появиться с задержкой.
GUILD_ID=

# Путь к JSON-хранилищу относительно папки проекта (обычно менять не нужно)
DATA_FILE=data/store.json

# DEBUG / INFO / WARNING
LOG_LEVEL=INFO
